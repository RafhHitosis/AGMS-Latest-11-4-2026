# PostgreSQL Database Connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=attendance_db

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend API URL; leave empty to use the local Vite /api proxy
VITE_API_URL=
CLIENT_URL=https://pagms.netlify.app/

# Generate a hash with `npm run auth:hash`; never put the password itself here.
AUTH_PASSWORD_HASH=
# Set to 1 when the server is behind one trusted reverse proxy (for example Render).
TRUST_PROXY_HOPS=0
